{
  "schema_version": "blocking-check-audit/v1",
  "scope": "Direct blocking/finding producers and shared evidence/normalization helpers in six production modules; nested checks fingerprinted within owning functions. External model judgement and host capability remain runtime obligations.",
  "baseline_commit": "29e401a",
  "families": {
    "source": {
      "authority": "Approved Source-of-Truth schema, branch requirements and clinical relationships",
      "false_rejection_risk": "Alias or source-shape differences; mixed enrollment/endpoint text needs source review before generation",
      "duplicate_policy": "source_contract owns normalization before approval; clinical evidence remains immutable",
      "coverage": "test_contracts.py; test_reliability_maintenance.py"
    },
    "evidence": {
      "authority": "SectionSpec evidence/ownership and shared section_evidence_value; semantic hypothesis contract",
      "false_rejection_risk": "Lexical overlap is a heuristic; structural IDs, bibliography and binary cells must be excluded by the shared projection",
      "duplicate_policy": "Drafting and Sterling consume shared projections and source_evidence_grounded; independent review still assesses meaning/relations",
      "coverage": "test_evidence_variations.py; test_evidence_diagnostics.py; test_assessment_matrix.py; test_hypothesis_fidelity.py; test_visit_identifier_scope.py; test_section_background_scope.py"
    },
    "clinical": {
      "authority": "Approved values plus Brad section ownership and governed template clauses",
      "false_rejection_risk": "Overbroad keyword rules or contradictory draft/render scopes; do not promote heuristic success into clinical approval",
      "duplicate_policy": "Shared evidence scope for sourced prose; exact legal text and placement retain separate authority",
      "coverage": "test_sterling_rendered_scope.py; test_phase2_sterling_fidelity.py; test_brad_editorial_feedback.py; test_sterling_template_comments.py"
    },
    "structured": {
      "authority": "Approved enrollment total, cohorts/interventions, endpoints, visits and PRS schema",
      "false_rejection_risk": "Dropping keys or guessing first numbers can destroy relationships; ambiguous matrix cells must not be guessed",
      "duplicate_policy": "contracts normalizes visit interpretation; table and narrative project that interpretation. PRS generation/validation share mapping helpers; independently asserted expected values in regression tests and full independent content review provide additional protection.",
      "coverage": "test_assessment_matrix.py; test_prs_quality_corrections.py; test_prs_xml.py; test_bilateral_review_block.py"
    },
    "render": {
      "authority": "Exact template topology, DOCX/PDF/page images and release-owned renderer",
      "false_rejection_risk": "Host environment, font capability, page splitting or sparse page classifications; host smoke does not certify every layout",
      "duplicate_policy": "Render defects route to layout/construction owner; complete fresh exact-artifact review follows repair",
      "coverage": "test_duration_reference_preservation.py; test_handoff_quality.py; host installation render smoke"
    },
    "review": {
      "authority": "Authenticated independent reviewer identity, complete source and artifact scope, exact hashes",
      "false_rejection_risk": "Malformed responses or targets can look like content defects; transport and semantic findings need different routes",
      "duplicate_policy": "Canonical request/evidence inventory shared across creation, recovery and final checks; source/no-invention findings remain blocking",
      "coverage": "test_handoff_quality.py; test_visit_inventory_review.py; test_hypothesis_fidelity.py"
    },
    "recovery": {
      "authority": "Persisted deadline, distinct completed attempts, recovery ownership and gate ledger",
      "false_rejection_risk": "Counting the same response repeatedly; generic diagnostics produce identical retries; transport retry must not consume drafting streak",
      "duplicate_policy": "workflow owns retry state and deadlines; diagnostics identify concrete evidence failure without extending retry limits",
      "coverage": "test_reliability_maintenance.py; test_worker_readiness.py"
    },
    "installation": {
      "authority": "Package manifest, installation/runtime integrity, exact worker profile and optional certification mode",
      "false_rejection_risk": "API-key profile mistaken for subscription; unsigned ordinary generation accidentally subjected to signed certification",
      "duplicate_policy": "Installation owns provisioning/smoke; ordinary manual review does not require certification; developer offline check is not activation preflight",
      "coverage": "test_worker_readiness.py; exact host installation integrity/render smoke; optional certification deliberately excluded"
    },
    "delivery": {
      "authority": "Final complete accepted review, atomic publication and exact client bytes",
      "false_rejection_risk": "Transient attachment access must retry the same bytes within the original deadline",
      "duplicate_policy": "One final artifact identity; client output never substitutes an unapproved candidate",
      "coverage": "test_reliability_maintenance.py; test_handoff_quality.py"
    }
  },
